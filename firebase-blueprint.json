{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product available for sale.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "An order placed by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "total", "status", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["uid"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and star rating.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "rating", "comment", "createdAt"]
    },
    "SupportInquiry": {
      "title": "SupportInquiry",
      "description": "Direct customer support inquiries.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products collection."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders collection."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer comments and rating values."
    },
    "/support_inquiries/{inquiryId}": {
      "schema": "SupportInquiry",
      "description": "Secure customer contact form inquiries."
    }
  }
}
